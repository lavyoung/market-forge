<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.activity.IActivityAccountDayDao">

    <resultMap id="activityAccountDayResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.activity.ActivityAccountDayPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="activity_id" property="activityId"/>
        <result column="day" property="day"/>
        <result column="day_count" property="dayCount"/>
        <result column="day_count_surplus" property="dayCountSurplus"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="activityAccountDayColumns">
        id, user_id, activity_id, day, day_count, day_count_surplus, version, create_time, update_time
    </sql>

    <select id="queryByUserIdAndActivityIdAndDay" resultMap="activityAccountDayResultMap">
        SELECT
        <include refid="activityAccountDayColumns"/>
        FROM raffle_activity_account_day
        WHERE user_id = #{userId}
        AND activity_id = #{activityId}
        AND day = #{day}
        LIMIT 1
    </select>

</mapper>
