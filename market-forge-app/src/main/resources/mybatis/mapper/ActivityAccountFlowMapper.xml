<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.activity.IActivityAccountFlowDao">

    <resultMap id="activityAccountFlowResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.activity.ActivityAccountFlowPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="activity_id" property="activityId"/>
        <result column="total_count" property="totalCount"/>
        <result column="day_count" property="dayCount"/>
        <result column="month_count" property="monthCount"/>
        <result column="flow_id" property="flowId"/>
        <result column="flow_channel" property="flowChannel"/>
        <result column="biz_id" property="bizId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="activityAccountFlowColumns">
        id, user_id, activity_id, total_count, day_count, month_count,
        flow_id, flow_channel, biz_id, create_time, update_time
    </sql>

    <select id="queryByFlowId" resultMap="activityAccountFlowResultMap">
        SELECT
        <include refid="activityAccountFlowColumns"/>
        FROM raffle_activity_account_flow
        WHERE flow_id = #{flowId}
        LIMIT 1
    </select>

    <select id="queryByBizId" resultMap="activityAccountFlowResultMap">
        SELECT
        <include refid="activityAccountFlowColumns"/>
        FROM raffle_activity_account_flow
        WHERE biz_id = #{bizId}
        LIMIT 1
    </select>

</mapper>
