<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.activity.IActivityAccountDao">

    <resultMap id="activityAccountResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.activity.ActivityAccountPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="activity_id" property="activityId"/>
        <result column="total_count" property="totalCount"/>
        <result column="total_count_surplus" property="totalCountSurplus"/>
        <result column="day_count" property="dayCount"/>
        <result column="day_count_surplus" property="dayCountSurplus"/>
        <result column="month_count" property="monthCount"/>
        <result column="month_count_surplus" property="monthCountSurplus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="activityAccountColumns">
        id, user_id, activity_id, total_count, total_count_surplus, day_count,
        day_count_surplus, month_count, month_count_surplus, create_time, update_time
    </sql>

    <select id="queryByUserIdAndActivityId" resultMap="activityAccountResultMap">
        SELECT
        <include refid="activityAccountColumns"/>
        FROM raffle_activity_account
        WHERE user_id = #{userId}
        AND activity_id = #{activityId}
        LIMIT 1
    </select>

    <update id="decrementTotalCountSurplus">
        UPDATE raffle_activity_account
        SET total_count_surplus = total_count_surplus - 1,
        day_count_surplus = day_count_surplus - 1,
        month_count_surplus = month_count_surplus - 1,
        update_time = NOW()
        WHERE user_id = #{userId}
        AND activity_id = #{activityId}
        AND total_count_surplus > 0
        AND day_count_surplus > 0
        AND month_count_surplus > 0
    </update>

</mapper>
