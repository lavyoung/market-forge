<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.activity.IActivityDao">

    <resultMap id="activityResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.activity.ActivityPO">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="activity_name" property="activityName"/>
        <result column="activity_desc" property="activityDesc"/>
        <result column="begin_date_time" property="beginDateTime"/>
        <result column="end_date_time" property="endDateTime"/>
        <result column="stock_count" property="stockCount"/>
        <result column="stock_count_surplus" property="stockCountSurplus"/>
        <result column="activity_count_id" property="activityCountId"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="award_unlock_scope" property="awardUnlockScope"/>
        <result column="state" property="state"/>
        <result column="version" property="version"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="activityColumns">
        id, activity_id, activity_name, activity_desc, begin_date_time, end_date_time,
        stock_count, stock_count_surplus, activity_count_id, strategy_id,
        award_unlock_scope, state, version, created_by, updated_by, create_time, update_time
    </sql>

    <sql id="activityDefinitionSearchWhere">
        <where>
            <if test="activityId != null">
                activity_id = #{activityId}
            </if>
            <if test="activityName != null">
                AND activity_name LIKE CONCAT(#{activityName}, '%')
            </if>
            <if test="state != null">
                AND state = #{state}
            </if>
        </where>
    </sql>

    <select id="queryByActivityId" resultMap="activityResultMap">
        SELECT
        <include refid="activityColumns"/>
        FROM raffle_activity
        WHERE activity_id = #{activityId}
        LIMIT 1
    </select>

    <select id="countActivityDefinitions"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.model.ActivityDefinitionSearchParam"
            resultType="long">
        SELECT COUNT(*)
        FROM raffle_activity
        <include refid="activityDefinitionSearchWhere"/>
    </select>

    <select id="queryActivityDefinitionPage"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.model.ActivityDefinitionSearchParam"
            resultMap="activityResultMap">
        SELECT
        <include refid="activityColumns"/>
        FROM raffle_activity
        <include refid="activityDefinitionSearchWhere"/>
        ORDER BY update_time DESC, id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <update id="updateDraftDefinition"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.po.activity.ActivityPO">
        UPDATE raffle_activity
        SET activity_name = #{activityName},
        activity_desc = #{activityDesc},
        begin_date_time = #{beginDateTime},
        end_date_time = #{endDateTime},
        stock_count = #{stockCount},
        stock_count_surplus = #{stockCountSurplus},
        activity_count_id = #{activityCountId},
        strategy_id = #{strategyId},
        award_unlock_scope = #{awardUnlockScope},
        updated_by = #{updatedBy},
        update_time = CURRENT_TIMESTAMP,
        version = version + 1
        WHERE activity_id = #{activityId}
        AND state = 'draft'
        AND version = #{version}
    </update>

    <update id="changeDefinitionState"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.model.ActivityDefinitionStateUpdateParam">
        UPDATE raffle_activity
        SET state = #{targetState},
        updated_by = #{operator},
        update_time = CURRENT_TIMESTAMP,
        version = version + 1
        WHERE activity_id = #{activityId}
        AND state = #{currentState}
        AND version = #{expectedVersion}
    </update>

</mapper>
