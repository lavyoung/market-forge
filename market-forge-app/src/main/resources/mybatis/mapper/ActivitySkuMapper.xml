<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.activity.IActivitySkuDao">

    <resultMap id="activitySkuResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.activity.ActivitySkuPO">
        <id column="id" property="id"/>
        <result column="sku" property="sku"/>
        <result column="activity_id" property="activityId"/>
        <result column="activity_count_id" property="activityCountId"/>
        <result column="stock_count" property="stockCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="activitySkuColumns">
        id, sku, activity_id, activity_count_id, stock_count, create_time, update_time
    </sql>

    <select id="queryBySku" resultMap="activitySkuResultMap">
        SELECT
        <include refid="activitySkuColumns"/>
        FROM raffle_activity_sku
        WHERE sku = #{sku}
        ORDER BY id DESC
        LIMIT 1
    </select>

    <update id="decrementStockCount">
        UPDATE raffle_activity_sku
        SET stock_count = stock_count - 1,
        update_time = CURRENT_TIMESTAMP
        WHERE sku = #{sku}
        AND activity_id = #{activityId}
        AND activity_count_id = #{activityCountId}
        AND stock_count &gt; 0
    </update>

</mapper>
