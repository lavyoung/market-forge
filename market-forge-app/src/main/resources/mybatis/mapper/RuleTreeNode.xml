<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.IRuleTreeNodeDao">


    <select id="queryByTreeIdsAndRuleKey"
            resultType="com.lavyoung.marketforge.infrastructure.persistent.po.RuleTreeNodePO">
        SELECT id, tree_id, rule_key, rule_desc, rule_value,
        create_time, update_time
        FROM rule_tree_node
        WHERE rule_key = #{ruleKey}
        AND tree_id IN
        <foreach collection="treeIds" item="treeId" open="(" separator="," close=")">
            #{treeId}
        </foreach>
    </select>
</mapper>
