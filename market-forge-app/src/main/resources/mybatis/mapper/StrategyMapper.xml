<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.IStrategyDao">

    <resultMap id="strategyResultMap" type="com.lavyoung.marketforge.infrastructure.persistent.po.StrategyPO">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="strategy_desc" property="strategyDesc"/>
        <result column="rule_models" property="ruleModels"/>
        <result column="state" property="state"/>
        <result column="version" property="version"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="strategyColumns">
        id, strategy_id, strategy_desc, rule_models, state, version,
        created_by, updated_by, create_time, update_time
    </sql>

    <sql id="strategyDefinitionSearchWhere">
        <where>
            <if test="strategyId != null">
                strategy_id = #{strategyId}
            </if>
            <if test="strategyDesc != null">
                AND strategy_desc LIKE CONCAT(#{strategyDesc}, '%')
            </if>
            <if test="state != null">
                AND state = #{state}
            </if>
        </where>
    </sql>

    <select id="queryStrategyByStrategyId" resultMap="strategyResultMap">
        SELECT <include refid="strategyColumns"/>
        FROM strategy
        WHERE strategy_id = #{strategyId}
        LIMIT 1
    </select>

    <select id="countStrategyDefinitions"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.model.StrategyDefinitionSearchParam"
            resultType="long">
        SELECT COUNT(*)
        FROM strategy
        <include refid="strategyDefinitionSearchWhere"/>
    </select>

    <select id="queryStrategyDefinitionPage"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.model.StrategyDefinitionSearchParam"
            resultMap="strategyResultMap">
        SELECT
        <include refid="strategyColumns"/>
        FROM strategy
        <include refid="strategyDefinitionSearchWhere"/>
        ORDER BY update_time DESC, id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <update id="updateDraft"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.po.StrategyPO">
        UPDATE strategy
        SET strategy_desc = #{strategyDesc},
        rule_models = #{ruleModels},
        updated_by = #{updatedBy},
        update_time = CURRENT_TIMESTAMP,
        version = version + 1
        WHERE strategy_id = #{strategyId}
        AND state = 'draft'
        AND version = #{version}
    </update>

    <update id="changeState"
            parameterType="com.lavyoung.marketforge.infrastructure.persistent.model.StrategyDefinitionStateUpdateParam">
        UPDATE strategy
        SET state = #{targetState},
        updated_by = #{operator},
        update_time = CURRENT_TIMESTAMP,
        version = version + 1
        WHERE strategy_id = #{strategyId}
        AND state = #{currentState}
        AND version = #{expectedVersion}
    </update>

</mapper>
