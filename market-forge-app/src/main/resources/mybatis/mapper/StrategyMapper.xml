<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.IStrategyDao">

    <resultMap id="strategyResultMap" type="com.lavyoung.marketforge.infrastructure.persistent.po.StrategyPO">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="strategy_desc" property="strategyDesc"/>
        <result column="rule_models" property="ruleModels"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="strategyColumns">
        id, strategy_id, strategy_desc, rule_models, create_time, update_time
    </sql>

    <select id="queryStrategyByStrategyId" resultMap="strategyResultMap">
        SELECT <include refid="strategyColumns"/>
        FROM strategy
        WHERE strategy_id = #{strategyId}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.lavyoung.marketforge.infrastructure.persistent.po.StrategyPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO strategy (strategy_id, strategy_desc, rule_models)
        VALUES (#{strategyId}, #{strategyDesc}, #{ruleModels})
    </insert>

    <update id="updateByStrategyId" parameterType="com.lavyoung.marketforge.infrastructure.persistent.po.StrategyPO">
        UPDATE strategy
        SET strategy_desc = #{strategyDesc},
            rule_models = #{ruleModels}
        WHERE strategy_id = #{strategyId}
    </update>

</mapper>
