<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.IUserAwardRecordDao">

    <resultMap id="userAwardRecordResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.UserAwardRecordPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="activity_id" property="activityId"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="order_id" property="orderId"/>
        <result column="award_id" property="awardId"/>
        <result column="award_title" property="awardTitle"/>
        <result column="award_time" property="awardTime"/>
        <result column="award_state" property="awardState"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="userAwardRecordColumns">
        id, user_id, activity_id, strategy_id, order_id, award_id, award_title,
        award_time, award_state, create_time, update_time
    </sql>

    <select id="queryByOrderId" resultMap="userAwardRecordResultMap">
        SELECT
        <include refid="userAwardRecordColumns"/>
        FROM user_award_record
        WHERE order_id = #{orderId}
        LIMIT 1
    </select>

</mapper>
