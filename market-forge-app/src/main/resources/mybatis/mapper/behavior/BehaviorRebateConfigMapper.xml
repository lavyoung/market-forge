<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lavyoung.marketforge.infrastructure.persistent.dao.behavior.IBehaviorRebateConfigDao">

    <resultMap id="behaviorRebateConfigResultMap"
               type="com.lavyoung.marketforge.infrastructure.persistent.po.behavior.BehaviorRebateConfigPO">
        <id column="id" property="id"/>
        <result column="behavior_type" property="behaviorType"/>
        <result column="rebate_type" property="rebateType"/>
        <result column="rebate_config" property="rebateConfig"/>
        <result column="rebate_desc" property="rebateDesc"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="behaviorRebateConfigColumns">
        id, behavior_type, rebate_type, rebate_config, rebate_desc, create_time, update_time
    </sql>

    <select id="queryByBehaviorType" resultMap="behaviorRebateConfigResultMap">
        SELECT
        <include refid="behaviorRebateConfigColumns"/>
        FROM behavior_rebate_config
        WHERE behavior_type = #{behaviorType}
    </select>

</mapper>