<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lavyoung.marketforge.infrastructure.dao.DemoMapper">

    <resultMap id="DemoResultMap"
               type="com.lavyoung.marketforge.infrastructure.po.DemoPO">

        <id property="id"
            column="id"/>

        <result property="name"
                column="name"/>

    </resultMap>

    <select id="selectById"
            resultMap="DemoResultMap">

        SELECT
            id,
            name
        FROM demo
        WHERE id = #{id}

    </select>

    <insert id="insert"
            parameterType="com.lavyoung.marketforge.infrastructure.po.DemoPO"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO demo (
            name
        )
        VALUES (
            #{name}
        )

    </insert>

</mapper>
