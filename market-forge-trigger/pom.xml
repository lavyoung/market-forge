<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lavyoung</groupId>
        <artifactId>market-forge</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>market-forge-trigger</artifactId>

    <name>${project.artifactId}-${revision}</name>
    <description>DDD trigger layer：承载 HTTP、RPC、MQ listener、定时任务等入站触发适配器，负责参数校验、协议转换和调用
        application 用例；禁止直接访问 repository、DAO 或编写领域规则。
    </description>

    <dependencies>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>market-forge-api</artifactId>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>market-forge-types</artifactId>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>market-forge-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            NoResourceFoundException extends jakarta.servlet.ServletException.
            Declare Tomcat core directly so Maven and IDE JPMS compilers both expose
            the module that owns the jakarta.servlet package to the trigger module.
        -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 动态限流核心接口。trigger 层使用其中的 @DccRateLimiter 注解声明入口限流规则。 -->
        <dependency>
            <groupId>io.github.lavyoung</groupId>
            <artifactId>dynamic-config-center-rate-limiter</artifactId>
        </dependency>

        <!-- 测试真实限流切面行为，不进入 trigger 生产运行时依赖。 -->
        <dependency>
            <groupId>io.github.lavyoung</groupId>
            <artifactId>dynamic-config-center-rate-limiter-spring-boot-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
    </dependencies>

</project>
